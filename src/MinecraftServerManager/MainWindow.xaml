<Window x:Class="MinecraftServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minecraft Server Manager" Width="1180" Height="760" MinWidth="850" MinHeight="580" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,8,0,26">
            <Border Width="34" Height="34" Background="{StaticResource GreenBrush}" Margin="0,0,12,0"/>
            <StackPanel><TextBlock Text="Minecraft" FontSize="20" FontWeight="Bold"/><TextBlock Text="SERVER MANAGER" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
          </StackPanel>
          <TextBlock Text="МОИ СЕРВЕРЫ" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="5,0,0,10"/>
          <ListBox x:Name="ServerList" SelectionChanged="ServerList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="200" MaxHeight="430"/>
          <Button x:Name="CreateButton" Content="+ Создать сервер" Style="{StaticResource PrimaryButton}" Margin="0,14,0,8" Click="CreateButton_Click"/>
          <Button Content="Подключить папку" Margin="0" Click="AttachButton_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock x:Name="UpdateStatus" Text="Проверка обновлений…" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,12"/>
          <Button Content="Проверить обновления" Margin="0,0,0,8" Click="CheckUpdateButton_Click"/>
          <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,25">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <TextBlock x:Name="StateBadge" DockPanel.Dock="Right" Text="Остановлен" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
        <StackPanel><TextBlock x:Name="TitleText" Text="Выберите сервер" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="SubtitleText" Text="Создавайте и управляйте серверами Bedrock и Java" Foreground="{StaticResource MutedBrush}"/></StackPanel>
      </DockPanel>
      <Border x:Name="NoticeBorder" Grid.Row="1" Background="#30231B" BorderBrush="#765F2D" BorderThickness="1" Padding="10" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#F1D38B"/></Border>
      <TabControl x:Name="Pages" Grid.Row="2" SelectionChanged="Pages_SelectionChanged">
        <TabItem Header="Обзор">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="StartButton" Content="Запустить" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/><Button x:Name="StopButton" Content="Остановить" Click="StopButton_Click"/><Button x:Name="RestartButton" Content="Перезапустить" Click="RestartButton_Click"/></StackPanel>
            <UniformGrid Columns="3" Margin="0,0,0,18">
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Редакция" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="EditionValue" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Память" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="Подключение" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="EndpointValue" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18"><StackPanel>
              <TextBlock Text="Сервер" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
              <TextBlock x:Name="FolderValue" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="PidValue" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal"><Button Content="Открыть папку" Click="OpenFolderButton_Click"/><Button Content="Создать копию мира" Click="BackupButton_Click"/><Button Content="Убрать из списка" Click="RemoveButton_Click"/></StackPanel>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Консоль">
          <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="ConsoleText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#090B09"/>
            <DockPanel Grid.Row="1" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Отправить" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SendButton_Click"/><TextBox x:Name="CommandText" KeyDown="CommandText_KeyDown"/></DockPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Настройки">
          <ScrollViewer><StackPanel Margin="16">
            <TextBlock Text="Параметры запуска" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="Имя сервера" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/>
            <TextBlock Text="Порт" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="PortBox" Margin="0,4,0,12"/>
            <TextBlock Text="Память Java, МБ" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MemoryBox" Margin="0,4,0,12"/>
            <TextBlock Text="Путь к Java (или java из PATH)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="JavaBox" Margin="0,4,0,12"/>
            <CheckBox x:Name="AutoRestartBox" Content="Перезапускать после неожиданного завершения" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
            <Button Content="Сохранить параметры" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveProfileButton_Click"/>
            <TextBlock Text="server.properties" FontSize="18" FontWeight="Bold" Margin="0,24,0,4"/>
            <TextBlock Text="После изменения файла перезапустите сервер. Старая версия сохраняется как .bak." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBox x:Name="PropertiesBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            <Button Content="Сохранить server.properties" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="SavePropertiesButton_Click"/>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Копии и файлы">
          <StackPanel Margin="16"><TextBlock Text="Резервные копии миров" FontSize="18" FontWeight="Bold"/><TextBlock Text="Копирование доступно при остановленном сервере. ZIP хранится в папке сервера / backups." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/><Button Content="Создать копию мира" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BackupButton_Click"/><ListBox x:Name="BackupList" Margin="0,15,0,0" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"/></StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
