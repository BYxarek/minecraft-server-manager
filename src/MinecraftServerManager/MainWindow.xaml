<Window x:Class="MinecraftServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:MinecraftServerManager" Style="{StaticResource MaterialDesignWindow}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" Title="Minecraft Server Manager" Width="1180" Height="760" MinWidth="850" MinHeight="580" WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,8,0,26">
            <Border Width="34" Height="34" Background="{StaticResource GreenBrush}" Margin="0,0,12,0"><materialDesign:PackIcon Kind="Server" Width="22" Height="22" Foreground="{StaticResource BackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel><TextBlock Text="Minecraft" FontSize="20" FontWeight="Bold"/><TextBlock Text="SERVER MANAGER" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
          </StackPanel>
          <TextBlock Text="{local:Loc MyServers}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="5,0,0,10"/>
          <ListBox x:Name="ServerList" SelectionChanged="ServerList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="200" MaxHeight="430"/>
          <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,8" Click="CreateButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc CreateServer}"/></StackPanel></Button>
          <Button Margin="0" Click="AttachButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderOpen" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc AttachFolder}"/></StackPanel></Button>
          <Button Margin="0,8,0,0" Click="TemplatesButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDocument" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc TemplateSettings}"/></StackPanel></Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><materialDesign:PackIcon Kind="Language" Style="{StaticResource UiIcon}"/><ComboBox x:Name="LanguageBox" Width="195" SelectionChanged="LanguageBox_SelectionChanged" ToolTip="{local:Loc Language}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Русский" Tag="ru"/></ComboBox></StackPanel>
          <TextBlock x:Name="UpdateStatus" Text="{local:Loc CheckingUpdates}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,8"/>
          <ProgressBar x:Name="UpdateProgressBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="4,0,4,12"/>
          <Button x:Name="CheckUpdateButton" Margin="0,0,0,8" Click="CheckUpdateButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc CheckUpdates}"/></StackPanel></Button>
          <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,25">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <TextBlock x:Name="StateBadge" DockPanel.Dock="Right" Text="{local:Loc Stopped}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontWeight="Bold"/>
        <StackPanel><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Server" Width="27" Height="27" Foreground="{StaticResource GreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="TitleText" Text="{local:Loc SelectServer}" FontSize="28" FontWeight="Bold"/></StackPanel><TextBlock x:Name="SubtitleText" Text="{local:Loc AppSubtitle}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
      </DockPanel>
      <Border x:Name="NoticeBorder" Grid.Row="1" Background="#302D18" BorderBrush="#6B632B" BorderThickness="1" Padding="10" Margin="0,0,0,14" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#BDB56A"/>
          <Button x:Name="NoticeOpenBackupButton" Content="{local:Loc ShowInExplorer}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="NoticeOpenBackupButton_Click"/>
          <StackPanel x:Name="ActivityRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <materialDesign:PackIcon Kind="Loading" Width="18" Height="18" Foreground="{StaticResource GreenBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
              <materialDesign:PackIcon.RenderTransform><RotateTransform/></materialDesign:PackIcon.RenderTransform>
              <materialDesign:PackIcon.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></materialDesign:PackIcon.Triggers>
            </materialDesign:PackIcon>
            <ProgressBar Width="350" Height="6" IsIndeterminate="True" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <TabControl x:Name="Pages" Grid.Row="2" SelectionChanged="Pages_SelectionChanged">
        <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Home" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Overview}"/></StackPanel></TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Play" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Start}"/></StackPanel></Button><Button x:Name="StopButton" Click="StopButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Stop" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Stop}"/></StackPanel></Button><Button x:Name="RestartButton" Click="RestartButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Restart" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Restart}"/></StackPanel></Button></StackPanel>
            <UniformGrid Columns="3" Margin="0,0,0,18">
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="{local:Loc Edition}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="EditionValue" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="{local:Loc Memory}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="{local:Loc Connection}" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="EndpointValue" Text="—" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18"><StackPanel>
              <TextBlock Text="{local:Loc Server}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
              <TextBlock x:Name="FolderValue" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="PidValue" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal"><Button Click="OpenFolderButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderOpen" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc OpenFolder}"/></StackPanel></Button><Button Click="BackupButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Archive" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc CreateBackup}"/></StackPanel></Button><Button x:Name="RemoveButton" Click="RemoveButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Delete" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc DeleteServer}"/></StackPanel></Button></StackPanel>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Console" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Console}"/></StackPanel></TabItem.Header>
          <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10"><TextBlock x:Name="SearchCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Style="{StaticResource UiIcon}"/><TextBox x:Name="ConsoleSearchBox" TextChanged="ConsoleSearchBox_TextChanged" ToolTip="{local:Loc ConsoleSearch}"/></DockPanel>
            <TextBox x:Name="ConsoleText" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#090B09"/>
            <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SendButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Send" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Send}"/></StackPanel></Button><TextBox x:Name="CommandText" KeyDown="CommandText_KeyDown"/></DockPanel>
          </Grid>
        </TabItem>
        <TabItem x:Name="PlayersTab"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroup" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc OnlinePlayers}"/></StackPanel></TabItem.Header>
          <StackPanel Margin="16">
            <TextBlock Text="{local:Loc OnlinePlayers}" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="OnlineStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
            <Button x:Name="RefreshPlayersButton" Content="{local:Loc RefreshPlayers}" HorizontalAlignment="Left" Click="RefreshPlayersButton_Click"/>
            <ListBox x:Name="OnlinePlayersList" MinHeight="120" MaxHeight="280" Margin="0,12,0,12" SelectionChanged="OnlinePlayersList_SelectionChanged"/>
            <WrapPanel>
              <Button x:Name="KickPlayerButton" Content="{local:Loc KickPlayer}" Click="KickPlayerButton_Click"/>
              <Button x:Name="OpPlayerButton" Content="{local:Loc GiveOperator}" Click="OpPlayerButton_Click"/>
              <Button x:Name="DeopPlayerButton" Content="{local:Loc RemoveOperator}" Click="DeopPlayerButton_Click"/>
              <Button x:Name="BanPlayerButton" Content="{local:Loc BanPlayer}" Click="BanPlayerButton_Click"/>
              <Button x:Name="AllowOnlinePlayerButton" Content="{local:Loc AddToAllowList}" Click="AllowOnlinePlayerButton_Click"/>
            </WrapPanel>
            <StackPanel x:Name="PardonRow" Orientation="Horizontal" Margin="0,12,0,0"><TextBox x:Name="PardonNameBox" Width="230" ToolTip="{local:Loc PlayerName}"/><Button Content="{local:Loc UnbanPlayer}" Click="UnbanPlayerButton_Click"/></StackPanel>
            <TextBlock Text="{local:Loc PlayerGameMode}" Margin="0,16,0,5"/>
            <StackPanel Orientation="Horizontal"><ComboBox x:Name="PlayerGameModeBox" Width="190" SelectedIndex="0"><ComboBoxItem Content="{local:Loc OptionSurvival}" Tag="survival"/><ComboBoxItem Content="{local:Loc OptionCreative}" Tag="creative"/><ComboBoxItem Content="{local:Loc OptionAdventure}" Tag="adventure"/><ComboBoxItem Content="{local:Loc OptionSpectator}" Tag="spectator"/></ComboBox><Button x:Name="SetPlayerGameModeButton" Content="{local:Loc ApplyPlayerGameMode}" Click="SetPlayerGameModeButton_Click"/></StackPanel>
            <TextBlock Text="{local:Loc PlayerMessage}" Margin="0,16,0,5"/>
            <StackPanel Orientation="Horizontal"><TextBox x:Name="PlayerMessageBox" Width="360"/><Button x:Name="MessagePlayerButton" Content="{local:Loc SendMessage}" Click="MessagePlayerButton_Click"/></StackPanel>
            <TextBlock Text="{local:Loc PlayerActionsHelp}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
          </StackPanel>
        </TabItem>
        <TabItem x:Name="AllowListTab"><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountCheck" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc AllowListTab}"/></StackPanel></TabItem.Header>
          <StackPanel Margin="16">
            <TextBlock Text="{local:Loc AllowListTab}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{local:Loc AllowListHelp}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
            <CheckBox x:Name="AllowListEnabledBox" Content="{local:Loc EnableAllowList}" Click="AllowListEnabledBox_Click"/>
            <ListBox x:Name="AllowListNames" MinHeight="120" MaxHeight="320" Margin="0,12,0,12" SelectionChanged="AllowListNames_SelectionChanged"/>
            <StackPanel Orientation="Horizontal"><TextBox x:Name="AllowListNameBox" Width="270" ToolTip="{local:Loc PlayerName}"/><Button Content="{local:Loc AddPlayer}" Click="AddAllowListButton_Click"/><Button x:Name="RemoveAllowListButton" Content="{local:Loc RemovePlayer}" Click="RemoveAllowListButton_Click"/><Button Content="{local:Loc RefreshPlayers}" Click="RefreshAllowListButton_Click"/></StackPanel>
          </StackPanel>
        </TabItem>
        <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Cog" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc Settings}"/></StackPanel></TabItem.Header>
          <ScrollViewer><StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><materialDesign:PackIcon Kind="Cog" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc LaunchSettings}" FontSize="18" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="{local:Loc ServerName}" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/>
            <TextBlock Text="{local:Loc Port}" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="PortBox" Margin="0,4,0,12"/>
            <StackPanel x:Name="JavaSettingsPanel">
              <TextBlock Text="{local:Loc JavaMemory}" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MemoryBox" Margin="0,4,0,12"/>
              <TextBlock Text="{local:Loc JavaPath}" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="JavaBox" Margin="0,4,0,12"/>
            </StackPanel>
            <CheckBox x:Name="AutoRestartBox" Content="{local:Loc AutoRestart}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveProfileButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSave" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc SaveSettings}"/></StackPanel></Button>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,6"><materialDesign:PackIcon Kind="Tune" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc SimpleServerSettings}" FontSize="18" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="{local:Loc SimpleServerSettingsHelp}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <local:SimplePropertiesEditor x:Name="SimpleEditor"/>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SavePropertiesButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSave" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc SaveServerOptions}"/></StackPanel></Button>
            <StackPanel Orientation="Horizontal" Margin="0,28,0,4"><materialDesign:PackIcon Kind="FileDocument" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc AdvancedProperties}" FontSize="18" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="{local:Loc PropertiesHelp}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBox x:Name="PropertiesBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" Height="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="SavePropertiesButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSave" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc SaveProperties}"/></StackPanel></Button>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Archive" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc BackupsAndFiles}"/></StackPanel></TabItem.Header>
          <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Archive" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc WorldBackups}" FontSize="18" FontWeight="Bold"/></StackPanel>
            <TextBlock Text="{local:Loc BackupHelp}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Click="BackupButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Archive" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc CreateBackup}"/></StackPanel></Button>
              <Button x:Name="RestoreButton" Click="RestoreButton_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="BackupRestore" Style="{StaticResource UiIcon}"/><TextBlock Text="{local:Loc RestoreSelected}"/></StackPanel></Button>
              <Button x:Name="OpenBackupButton" Content="{local:Loc ShowInExplorer}" Click="OpenBackupButton_Click"/>
            </StackPanel>
            <TextBlock Text="{local:Loc AutomaticBackup}" Margin="0,16,0,5"/>
            <ComboBox x:Name="BackupIntervalBox" Width="200" HorizontalAlignment="Left" SelectionChanged="BackupIntervalBox_SelectionChanged"><ComboBoxItem Content="{local:Loc Disabled}" Tag="0"/><ComboBoxItem Content="{local:Loc Every6Hours}" Tag="6"/><ComboBoxItem Content="{local:Loc Every12Hours}" Tag="12"/><ComboBoxItem Content="{local:Loc Every24Hours}" Tag="24"/></ComboBox>
            <TextBlock x:Name="BackupProgressText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            <ProgressBar x:Name="BackupProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,0"/>
            <ListBox x:Name="BackupList" Margin="0,15,0,0" SelectionChanged="BackupList_SelectionChanged" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"/>
          </StackPanel>
        </TabItem>
      </TabControl>
      <StackPanel x:Name="NoSelectionPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
        <materialDesign:PackIcon Kind="Server" Width="48" Height="48" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{local:Loc ChooseOrCreateServer}" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
    </Grid>
    <Border x:Name="InlineOverlay" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#E8101310" Visibility="Collapsed">
      <Border Width="720" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="InlineContent"/></ScrollViewer>
      </Border>
    </Border>
  </Grid>
</Window>
