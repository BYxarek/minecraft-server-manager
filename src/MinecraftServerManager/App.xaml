<Application x:Class="MinecraftServerManager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Green" SecondaryColor="LightGreen" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Minecraft palette: near-black surfaces, green accents, and subdued green text. -->
      <SolidColorBrush x:Key="BackgroundBrush" Color="#101310" />
      <SolidColorBrush x:Key="SideBrush" Color="#171B17" />
      <SolidColorBrush x:Key="PanelBrush" Color="#1B211B" />
      <SolidColorBrush x:Key="InputBrush" Color="#111511" />
      <SolidColorBrush x:Key="LineBrush" Color="#303830" />
      <SolidColorBrush x:Key="TextBrush" Color="#A7C4A5" />
      <SolidColorBrush x:Key="MutedBrush" Color="#789578" />
      <SolidColorBrush x:Key="GreenBrush" Color="#67C36B" />
      <SolidColorBrush x:Key="PrimaryGreenBrush" Color="#286B35" />

      <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#67C36B" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light" Color="#86D58A" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark" Color="#286B35" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="#67C36B" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Light" Color="#86D58A" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Dark" Color="#286B35" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="#101310" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Surface" Color="#1B211B" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="#A7C4A5" />
      <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground.Light" Color="#789578" />

      <Style x:Key="UiIcon" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="#232923" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="#388B48" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CaretBrush" Value="{StaticResource GreenBrush}" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="6" />
      </Style>
      <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      </Style>
      <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
        <Setter Property="Background" Value="{StaticResource SideBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="16,9" />
      </Style>
      <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
